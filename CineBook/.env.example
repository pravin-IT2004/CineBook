# ------------------------------------------------------------------
# CineBook configuration template.
# Do NOT edit this file with real secrets. Instead run:
#     python scripts/create_env.py
# which copies it to .env and fills in random secrets for you.
# .env is listed in .gitignore and must never be committed.
# ------------------------------------------------------------------

# --- MongoDB ---
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=cinebook
MONGO_TIMEOUT_MS=3000
# auto  = use multi-document transactions only when MongoDB runs as a replica set
# false = always use atomic single-document operations + compensation (works on standalone MongoDB)
USE_TRANSACTIONS=auto

# --- Security (create_env.py generates these) ---
JWT_SECRET=change-me-run-scripts-create_env-py
JWT_EXPIRE_MINUTES=720

# --- First-run administrator (created once, on first API start or seed) ---
ADMIN_EMAIL=admin@cinebook.app
ADMIN_PASSWORD=
ADMIN_NAME=CineBook Admin

# --- URLs ---
# Address the Streamlit frontend uses to reach the API
API_BASE_URL=http://127.0.0.1:8000
# Public address encoded in ticket QR codes (use your LAN IP to scan from a phone)
PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Localisation ---
APP_TIMEZONE=Asia/Kolkata
CURRENCY_SYMBOL=₹

# --- Optional: e-mail confirmations (leave SMTP_HOST empty to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Misc ---
LOG_LEVEL=INFO
CLEANUP_INTERVAL_SECONDS=60
